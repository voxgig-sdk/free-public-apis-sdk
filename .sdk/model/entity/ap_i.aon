# Entity: ap_i

main: kit: entity: ap_i: {

  alias: field: {}

  fields: [
    {
      name: "auth"
      req: false
      short: "Authentication type required"
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      short: "Category of the API"
      type: "`$STRING`"
    }
    {
      name: "cors"
      req: false
      short: "CORS support status"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Description of the API functionality"
      type: "`$STRING`"
    }
    {
      name: "https"
      req: false
      short: "Whether the API supports HTTPS"
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the API"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Name of the API"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the API"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "tested"
      req: false
      short: "Last tested timestamp"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "URL of the API"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "ap_i"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "category"
                orig: "category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api.php"
          segments: [
            {
              lit: "api.php"
            }
          ]
          select: {
            exist: [
              "category"
              "limit"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.apis`"
          }
        }
      ]
    }
  }



}
